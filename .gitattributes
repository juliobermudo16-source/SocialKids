# Normalizacion de fin de linea
* text=auto eol=lf

# Scripts que deben conservar LF si o si
gradlew         text eol=lf
*.sh            text eol=lf
*.kt            text eol=lf
*.kts           text eol=lf
*.xml           text eol=lf
*.md            text eol=lf
*.sql           text eol=lf
*.py            text eol=lf
*.yml           text eol=lf
*.toml          text eol=lf
*.pro           text eol=lf
*.properties    text eol=lf

# Scripts de Windows
gradlew.bat     text eol=crlf
*.bat           text eol=crlf

# Binarios: nunca se tocan
*.apk           binary
*.aab           binary
*.pdf           binary
*.png           binary
*.jpg           binary
*.jar           binary
*.zip           binary
*.keystore      binary
*.jks           binary
